+            upstream=upstream,
+            upstream_voice=get("upstream_voice", str, None),
+            upstream_speaker=get("upstream_speaker", str, None),
+        )
+
+    piper_voice = get("piper_voice", str, None)
+    piper_model = get("piper_model", str, None)
+    piper_config = get("piper_config", str, None)
